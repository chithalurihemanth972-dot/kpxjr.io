# ═══════════════════════════════════════════════════════════════
#  KProjectXX — server env vars (the lead mailer in api/send-lead.ts)
#
#  Copy to `.env.local` for `vercel dev` / local testing, or set these
#  in Vercel → Project → Settings → Environment Variables.
#
#  ⚠️  NEVER put these in `src/` — everything in `src/` is shipped to
#     every visitor in the browser bundle. The app password must stay
#     on the server.
# ═══════════════════════════════════════════════════════════════

# SMTP server (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The Gmail account that sends the alerts
SMTP_USER=teamkprojectxx@gmail.com

# Gmail app password (16 chars, no spaces) — Google Account → Security →
# 2-Step Verification → App passwords
SMTP_PASS=

# Where the lead alerts should be delivered (defaults to SMTP_USER)
LEAD_NOTIFY_TO=teamkprojectxx@gmail.com

# Display name of the sender
LEAD_NOTIFY_FROM=KProjectXX Website <teamkprojectxx@gmail.com>

# Team number (country code + digits only) for the "Share to team" button
TEAM_WHATSAPP=918008115595

# Optional: extra origins allowed to POST leads (comma-separated)
# LEAD_ALLOWED_ORIGINS=https://kpxjr.io
